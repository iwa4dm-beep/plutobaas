# ─────────────────────────────────────────────────────────────
# Pluto BaaS — Next.js starter env template
# Copy to `.env.local` and fill in values from Dashboard → Projects.
# ─────────────────────────────────────────────────────────────

# Public (browser + server). Base URL of your Pluto API.
#   Local docker:  http://localhost:8000
#   Cloud/VPS:     https://api.<your-domain>
NEXT_PUBLIC_PLUTO_URL=http://localhost:8000

# Public anon key (safe to expose). Dashboard → Projects → API Keys → anon.
NEXT_PUBLIC_PLUTO_ANON_KEY=replace-with-anon-key

# Server-only. Used by webhook handler and any privileged server code.
# NEVER expose to the browser. Dashboard → Projects → API Keys → service_role.
PLUTO_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only. Shared secret configured on the Pluto webhook (HMAC-SHA256).
# Dashboard → Ops → Settings → Webhook signing secret.
PLUTO_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Optional. Used by E2E tests to create/login a disposable user.
E2E_TEST_EMAIL=e2e+starter@example.com
E2E_TEST_PASSWORD=StrongPass!2026
